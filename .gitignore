# --- generated at runtime -------------------------------------------------
__pycache__/
*.pyc
.venv/
venv/

# --- the model weights themselves ----------------------------------------
# Adapters are large and are rebuilt by the training notebook. What is tracked
# is models/MANIFEST.md, which records where each pack came from and what it
# scored -- so a missing .safetensors is recoverable, not lost.
models/*
!models/MANIFEST.md
!models/.gitkeep

# --- corpora --------------------------------------------------------------
# VRSBench is 12.5 GB and BigEarthNet imagery is 155 GB. Neither belongs in git.
data/

# --- front end ------------------------------------------------------------
web/node_modules/
web/dist/
web/shots/
