# --- generated at runtime -------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.ipynb_checkpoints/
.venv/
venv/
env/

# --- secrets --------------------------------------------------------------
# kaggle.json holds a live API token. A pushed token is a revoked token at
# best; assume anything committed here has been read by someone.
.env
.env.*
kaggle.json
.kaggle/
*.pem
*.key
secrets.json

# --- the model weights themselves ----------------------------------------
# Adapters are large and are rebuilt by the training scripts. What is tracked is
# 167/models/MANIFEST.md, which records where each pack came from and what it
# scored -- so a missing .safetensors is recoverable, not lost.
#
# The scripts that PRODUCE the weights are source and ARE tracked. The
# deliverable is "codes and models including test and demonstration"; an
# untracked training script means the result cannot be reproduced.
167/models/*
!167/models/MANIFEST.md
!167/models/README.md
!167/models/requirements.txt
!167/models/*.py
!167/models/common/
!167/models/adapters/
!167/models/eval/
!167/models/.gitkeep
!167/models/results/

# Evidence is small and IS tracked: predictions and summaries are a few hundred
# kilobytes each, and MANIFEST.md's rule 5 depends on them -- every number in it
# must be recomputable by a reader rather than taken on trust. The WEIGHTS those
# numbers came from stay untracked above; they are rebuildable, the evidence is
# not.
!167/models/results/*.jsonl
!167/models/results/*.json
!167/models/adapters/**/training_record.json

*.safetensors
*.bin
*.pt
*.pth
*.ckpt
*.gguf
*.onnx

# --- training and evaluation output ---------------------------------------
# Predictions, checkpoints and logs are reproducible from the script plus the
# recorded config. The measured NUMBERS belong in models/MANIFEST.md, which is
# tracked; the artefacts that produced them do not.
runs/
checkpoints/
outputs/
wandb/
lightning_logs/
*.log

# --- corpora --------------------------------------------------------------
# VRSBench is 12.5 GB and BigEarthNet imagery is 155 GB. Neither belongs in git,
# and neither needs to: both are a one-line snapshot_download away, and on a
# cloud GPU that download is minutes.
data/
datasets/
*.zip
*.tar
*.tar.gz
*.lmdb/

# --- front end ------------------------------------------------------------
167/web/node_modules/
167/web/dist/
167/web/shots/

# --- editors and operating systems ----------------------------------------
.DS_Store
Thumbs.db
desktop.ini
.idea/
*.swp
*.swo
*~

# --- backend runtime state -----------------------------------------------
# Uploaded rasters and stored runs. Reproducible from inputs + seed (OPS-02).
/var/
/167/var/
/runs/
/167/runs/
*.egg-info/

# --- raw training downloads ------------------------------------------------
# What comes back from a Kaggle run before anything is picked out of it:
# checkpoints with optimizer state, ~250 MB per run. The pack and the evidence
# are copied into models/ and tracked from there; the raw folder never is.
167/qwen2vl_*/
167/baseline/

# --- local leftovers, not part of this repository ----------------------------
# Mridul/ is a pre-restructure copy of SatQuery; dark-transit/ is the old
# location of what now lives in 143/. Together ~550 MB, almost all node_modules
# and run output. Ignored, not deleted -- that call is the owner's.
Mridul/
dark-transit/
# --- adapter packs staged for serving --------------------------------------
# satquery serve / docker compose read packs from 167/adapters/. They hold
# weights; the manifest of where each came from is 167/models/MANIFEST.md.
/167/adapters/*
!/167/adapters/README.md
